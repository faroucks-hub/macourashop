{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/route?__path=/api/:path*" },
    { "source": "/media/:path*", "destination": "/api/route?__path=/media/:path*" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/((?!api/|media/|assets/|.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] },
    { "source": "/assets/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
    ] },
    { "source": "/(app.js|variants.mjs|commerce.mjs|operations.mjs|storefront.mjs|product-lifecycle.mjs|styles.css|interface.css)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
    ] },
    { "source": "/index.html", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] }
  ]
}
