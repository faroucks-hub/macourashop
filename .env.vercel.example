# URL finale sans barre oblique, par exemple https://shop.example.com
SITE_ORIGIN=
ADMIN_EMAIL=

# Authentification clientes et gérante
CUSTOMER_AUTH_URL=https://PROJECT.supabase.co
CUSTOMER_AUTH_PUBLIC_KEY=

# Connexion serveur PostgreSQL Supabase (Transaction pooler, port 6543)
SUPABASE_DB_URL=

# Clé strictement serveur : ne jamais l'exposer dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=macourashop-private
